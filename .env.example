# Copier en .env.local — jamais commité (voir .gitignore).

# Stripe — compte existant du client. Clés de test pour développer, clés live
# uniquement sur Vercel, jamais sur une machine de développement.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase — réservations, tarifs, clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Repli du tunnel de réservation.
# "interne"  = le moteur du site encaisse (cible).
# "wordpress" = les boutons renvoient vers book.alpsskitransfers.com (secours).
# La bascule dans les deux sens se fait ici, sans redéploiement du code.
NEXT_PUBLIC_MOTEUR_RESERVATION=wordpress
NEXT_PUBLIC_URL_RESERVATION_REPLI=https://book.alpsskitransfers.com

# Calcul d'itinéraire — Google Distance Matrix.
# La clé du WordPress actuel était VIDE : son calcul par distance ne pouvait pas
# fonctionner. Sans clé ici, le moteur retombe sur les distances déjà publiées.
GOOGLE_MAPS_API_KEY=

# E-mails de confirmation (client + exploitant), envoyés en REST via Resend.
# Sans RESEND_API_KEY, le moteur enregistre la demande mais n'envoie rien : il le
# dit alors dans sa réponse plutôt que d'afficher une confirmation qui n'existe pas.
RESEND_API_KEY=
EMAIL_EXPEDITEUR=bookings@alpsskitransfers.com
EMAIL_EXPLOITANT=
